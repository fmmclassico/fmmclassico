const DEFAULT_IMAGE_MAX_BYTES = 180 * 1024;
const DEFAULT_IMAGE_MAX_DIMENSION = 2000;
const MIN_IMAGE_QUALITY = 0.45;
const QUALITY_STEP = 0.08;
const DIMENSION_STEP = 0.85;

function isImageFile(file) {
  return !!file && typeof file.type === 'string' && file.type.startsWith('image/');
}

function buildOutputName(name = '', mimeType = 'image/webp') {
  const base = String(name || 'upload').replace(/\.[^.]+$/, '') || 'upload';
  const extension = mimeType === 'image/png' ? 'png' : mimeType === 'image/jpeg' ? 'jpg' : 'webp';
  return `${base}.${extension}`;
}

function loadImageFromFile(file) {
  return new Promise((resolve, reject) => {
    const objectUrl = URL.createObjectURL(file);
    const image = new Image();
    image.onload = () => {
      URL.revokeObjectURL(objectUrl);
      resolve(image);
    };
    image.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      reject(new Error('Could not read the selected image.'));
    };
    image.src = objectUrl;
  });
}

function canvasToBlob(canvas, mimeType, quality) {
  return new Promise((resolve, reject) => {
    canvas.toBlob((blob) => {
      if (!blob) {
        reject(new Error('Image compression failed.'));
        return;
      }
      resolve(blob);
    }, mimeType, quality);
  });
}

export async function optimizeImageFile(file, options = {}) {
  if (!isImageFile(file)) return file;

  const maxBytes = Number(options.maxBytes) > 0 ? Number(options.maxBytes) : DEFAULT_IMAGE_MAX_BYTES;
  const maxDimension = Number(options.maxDimension) > 0 ? Number(options.maxDimension) : DEFAULT_IMAGE_MAX_DIMENSION;

  if (file.size <= maxBytes) return file;

  const image = await loadImageFromFile(file);
  const longestSide = Math.max(image.width || 0, image.height || 0) || 1;
  const initialScale = Math.min(1, maxDimension / longestSide);

  let width = Math.max(1, Math.round((image.width || 1) * initialScale));
  let height = Math.max(1, Math.round((image.height || 1) * initialScale));
  let quality = 0.82;
  const mimeType = file.type === 'image/png' ? 'image/png' : 'image/webp';

  while (true) {
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;

    const context = canvas.getContext('2d', { alpha: mimeType === 'image/png' });
    if (!context) return file;

    if (mimeType === 'image/jpeg' || mimeType === 'image/webp') {
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, width, height);
    }
    context.drawImage(image, 0, 0, width, height);

    const blob = await canvasToBlob(canvas, mimeType, quality);
    if (blob.size <= maxBytes || (quality <= MIN_IMAGE_QUALITY && Math.max(width, height) <= 960)) {
      return new File([blob], buildOutputName(file.name, mimeType), {
        type: mimeType,
        lastModified: Date.now(),
      });
    }

    if (quality > MIN_IMAGE_QUALITY) {
      quality = Math.max(MIN_IMAGE_QUALITY, Number((quality - QUALITY_STEP).toFixed(2)));
      continue;
    }

    width = Math.max(1, Math.round(width * DIMENSION_STEP));
    height = Math.max(1, Math.round(height * DIMENSION_STEP));
  }
}

export async function prepareUploadFile(file, options = {}) {
  if (!file) return file;
  if (isImageFile(file) && typeof document !== 'undefined') {
    try {
      return await optimizeImageFile(file, options);
    } catch (error) {
      console.warn('[UploadOptimizer] Falling back to original file:', error);
      return file;
    }
  }
  return file;
}
