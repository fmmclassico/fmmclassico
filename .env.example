# Frontend app configuration
VITE_APP_BASE_URL=https://www.fmmclassico.com
VITE_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# Optional frontend mirror values for display and local development
VITE_HUBTEL_MERCHANT_ACCOUNT_NUMBER=<YOUR_HUBTEL_MERCHANT_ACCOUNT_NUMBER>
VITE_ADMIN_EMAILS=<ADMIN_EMAILS_COMMA_SEPARATED>

# Supabase Edge Function secrets (set these in the Supabase project, not in shipped frontend code)
HUBTEL_CLIENT_ID=<YOUR_HUBTEL_CLIENT_ID>
HUBTEL_CLIENT_SECRET=<YOUR_HUBTEL_CLIENT_SECRET>
HUBTEL_API_ID=<OPTIONAL_LEGACY_HUBTEL_API_ID>
HUBTEL_API_KEY=<OPTIONAL_LEGACY_HUBTEL_API_KEY>
HUBTEL_MERCHANT_ACCOUNT_NUMBER=<YOUR_HUBTEL_MERCHANT_ACCOUNT_NUMBER>
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
ADMIN_EMAILS=<ADMIN_EMAILS_COMMA_SEPARATED>

# Admin and access control
VITE_ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>
VITE_MASTER_ADMIN_EMAIL=<YOUR_MASTER_ADMIN_EMAIL>
VITE_ALLOWED_ADMIN_EMAILS=<OPTIONAL_ALLOWED_ADMIN_EMAILS_COMMA_SEPARATED>

# Merchant contact
VITE_MERCHANT_PHONE=<YOUR_SUPPORT_PHONE>
VITE_MERCHANT_EMAIL=<YOUR_SUPPORT_EMAIL>
VITE_MERCHANT_WHATSAPP_URL=<YOUR_WHATSAPP_URL>
VITE_FEEDBACK_EMAIL=<YOUR_FEEDBACK_EMAIL>

# Optional Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
VITE_CLOUDINARY_UPLOAD_PRESET=<YOUR_CLOUDINARY_UPLOAD_PRESET>
