{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number"
    },
    "items": {
      "type": "array",
      "description": "Order items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "product_image": { "type": "string" },
          "price": { "type": "number" },
          "quantity": { "type": "number" },
          "selected_color": { "type": "string" },
          "selected_wattage": { "type": "string" },
          "selected_type": { "type": "string" },
          "variant_summary": { "type": "string" },
          "options_signature": { "type": "string" }
        }
      }
    },
    "product_subtotal": {
      "type": "number",
      "description": "Total of products before delivery"
    },
    "delivery_fee": {
      "type": "number",
      "description": "Delivery fee charged"
    },
    "grand_total": {
      "type": "number",
      "description": "Full order value including delivery"
    },
    "amount_paid_now": {
      "type": "number",
      "description": "Amount charged immediately at checkout"
    },
    "total_amount": {
      "type": "number",
      "description": "Legacy total field kept for compatibility; store the full order value here"
    },
    "balance_due": {
      "type": "number",
      "description": "Amount still to be paid on delivery (0 for full payment)"
    },
    "remaining_balance_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the remaining delivery-side balance has been confirmed by admin"
    },
    "remaining_balance_paid_at": {
      "type": "string",
      "description": "Timestamp when the remaining balance was confirmed"
    },
    "payment_method": {
      "type": "string",
      "enum": ["full_payment", "deposit_balance", "pay_on_delivery"],
      "description": "Payment method chosen at checkout"
    },
    "delivery_zone": {
      "type": "string",
      "description": "Delivery zone selected"
    },
    "payment_status": {
      "type": "string",
      "enum": ["pending_payment", "paid", "failed", "cancelled", "refunded"],
      "default": "pending_payment",
      "description": "Initial online payment status from Hubtel"
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "processing", "packed", "shipped", "out_for_delivery", "delivered", "cancelled", "returned"],
      "default": "confirmed",
      "description": "Fulfillment status"
    },
    "customer_name": { "type": "string" },
    "customer_email": { "type": "string" },
    "customer_phone": { "type": "string" },
    "delivery_address": { "type": "string" },
    "city": { "type": "string" },
    "map_location": { "type": "string", "description": "GPS link" },
    "notes": { "type": "string" },
    "estimated_delivery": { "type": "string", "format": "date" },
    "tracking_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "message": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "hubtel_transaction_id": { "type": "string", "description": "(Deprecated)" },
    "hubtel_status": { "type": "string", "enum": ["initiated", "pending", "successful", "failed"], "default": "initiated", "description": "(Deprecated)" },
    "payment_reference": { "type": "string", "description": "(Deprecated)" }
  },
  "required": ["items", "total_amount", "customer_name", "customer_email", "delivery_address"],
  "rls": {
    "create": {
      "$or": [
        { "data.customer_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.customer_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
